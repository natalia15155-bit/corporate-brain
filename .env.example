# AI provider. Use "demo" for offline work or "openrouter" for live synthesis.
AI_PROVIDER=demo
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=Corporate Brain

# Reserved alternatives. Never commit real keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=

# DataHub
EVIDENCE_SOURCE=demo
DATAHUB_MCP_URL=
DATAHUB_TOKEN=
DATAHUB_WRITEBACK_ENABLED=false
# For local DataHub Core + official MCP server:
# DATAHUB_MCP_TRANSPORT=stdio
# DATAHUB_GMS_URL=http://localhost:8080
# DATAHUB_MCP_COMMAND=uvx
# DATAHUB_MCP_ARGS=mcp-server-datahub==0.6.0

# Safety
ALLOW_PAID_MODELS=false
DEMO_MODE=true
